{
  "name": "anatomiya",
  "version": "0.1.7",
  "private": true,
  "description": "Counts what your code already does, directory by directory, and writes those counts into .claude/rules/ where a coding agent picks them up when it reads a file there",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "code-review",
    "conventions",
    "codebase",
    "agent-context",
    "static-analysis"
  ],
  "homepage": "https://github.com/crisnahine/anatomiya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crisnahine/anatomiya.git"
  },
  "bugs": {
    "url": "https://github.com/crisnahine/anatomiya/issues"
  },
  "license": "MIT",
  "author": {
    "name": "crisnahine",
    "url": "https://github.com/crisnahine"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    ".claude-plugin/",
    "bin/",
    "commands/",
    "lib/",
    "CHANGELOG.md",
    "DECISIONS.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.mjs'",
    "test:watch": "node --test --watch 'test/**/*.test.mjs'",
    "scan": "node bin/anatomiya.mjs scan .",
    "validate": "node scripts/validate.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=87 --test-coverage-functions=95 'test/**/*.test.mjs'"
  },
  "dependencies": {
    "oxc-parser": "^0.144.0"
  }
}
